# Database - Prisma Postgres (via console.prisma.io)
# One connection string handles everything: normal app queries AND schema
# changes (npm run db:push). Copy the full value shown after enabling
# Accelerate on your Prisma Postgres database - starts with prisma+postgres://
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=your_key_here"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"

# Paystack (leave blank until ready, fill in before going live)
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# Cledanet data supplier API (backend.mycledanet.com)
SUPPLIER_API_BASE_URL="https://backend.mycledanet.com/api"
SUPPLIER_API_KEY=""
# Note: Cledanet's optional order callback has no documented signing scheme,
# so there's no separate webhook secret to configure here - the webhook
# handler (/api/webhooks/cledanet) treats any incoming callback only as a
# trigger to re-verify the order directly via their authenticated GET
# endpoint, never trusting the callback body itself.

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Rancel DataHub"

# WhatsApp floating button - admin's WhatsApp number, international format, no + or spaces
# e.g. 233241234567 for a Ghana number starting 024
NEXT_PUBLIC_WHATSAPP_NUMBER="233000000000"

# Cron secret - protects the automated pending-order sweep from being triggered
# by random people. Vercel sets this automatically for its own scheduled cron
# calls once you add CRON_SECRET here and in your Vercel project settings.
CRON_SECRET="change-this-to-another-long-random-string"

# Gemini AI (for the AI Tools) - get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model name if Google renames it
GEMINI_MODEL=gemini-3.6-flash

# Cloudinary (product image uploads) - https://cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gmail API - only needed if you sell a "GMAIL_LATEST" digital product
# (reveals the latest email under a label, for a timed window). See
# README.md "Gmail-reveal products" section for the one-time setup.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI="http://localhost:3000/oauth2callback"
GMAIL_REFRESH_TOKEN=

# SMSPool (rented numbers for SMS verification, sold as "SMS Numbers" in the shop)
SMSPOOL_API_KEY=
SMSPOOL_API_URL="https://api.smspool.net"
