+
+      res = await fetch("/api/admin/code-accounts", {
+        method: "DELETE",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ id: acc.id, force: true }),
+      });
+      data = await res.json();
+    }
+
     if (!res.ok) alert(data?.error || "Could not delete.");
     load();
   }
