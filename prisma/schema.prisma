generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  phone        String        @unique
  passwordHash String
  role         Role          @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  aiCredits    Int           @default(5)
  afaOrders    AfaOrder[]
  agentProfile AgentProfile?
  boostOrders  BoostOrder[]
  smsOrders    SmsOrder[]
  smsWalletBalance Float                  @default(0)
  smsWalletTx      SmsWalletTransaction[]
  dataOrders   DataOrder[]
  pinOrders    PinOrder[]
}

model DataBundle {
  id                String      @id @default(uuid())
  network           String
  label             String
  dataSizeGb        Float
  supplierPackageId String
  costPrice         Float
  sellingPrice      Float
  validityDays      Int         @default(30)
  active            Boolean     @default(true)
  updatedAt         DateTime    @updatedAt
  agentSales        AgentSale[]
  orders            DataOrder[]
}

model DataOrder {
  id                String            @id @default(uuid())
  userId            String?
  guestEmail        String?
  bundleId          String
  beneficiaryNumber String
  amount            Float
  paystackReference String?           @unique
  paymentStatus     PaymentStatus     @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(NOT_STARTED)
  supplierOrderId   String?
  failureReason     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  agentCommission   Float?
  referredByAgentId String?
  bundle            DataBundle        @relation(fields: [bundleId], references: [id])
  user              User?             @relation(fields: [userId], references: [id])
}

model PinBatch {
  id           String   @id @default(uuid())
  examType     String
  year         Int
  costPrice    Float
  sellingPrice Float
  uploadedBy   String
  createdAt    DateTime @default(now())
  pins         Pin[]
}

model Pin {
  id             String    @id @default(uuid())
  batchId        String
  serialNumber   String
  pinCode        String
  status         PinStatus @default(AVAILABLE)
  soldToUserId   String?
  soldAt         DateTime?
  batch          PinBatch  @relation(fields: [batchId], references: [id])
  pinOrder       PinOrder?
  @@unique([batchId, serialNumber])
}

model PinOrder {
  id                String        @id @default(uuid())
  userId            String?
  guestPhone        String?
  guestEmail        String?
  pinId             String?       @unique
  examType          String
  year              Int
  amount            Float
  paystackReference String?       @unique
  paymentStatus     PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  pin               Pin?          @relation(fields: [pinId], references: [id])
  user              User?         @relation(fields: [userId], references: [id])
}

model AfaOrder {
  id                String        @id @default(uuid())
  userId            String?
  agentId           String?
  guestEmail        String?
  fullName          String
  phoneNumber       String
  idNumber          String
  dateOfBirth       String
  town              String
  occupation        String
  region            String
  cropProduce       String?
  amount            Float
  paystackReference String?       @unique
  paymentStatus     PaymentStatus @default(PENDING)
  supplierId        String?
  supplierStatus    String?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  agent             AgentProfile? @relation(fields: [agentId], references: [id])
  user              User?         @relation(fields: [userId], references: [id])
}

model AfaSettings {
  id    String @id @default("default")
  price Float  @default(10)
}

model Refund {
  id        String   @id @default(uuid())
  orderType String
  orderId   String
  reason    String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentProfile {
  id              String             @id @default(uuid())
  userId          String             @unique
  status          AgentStatus        @default(PENDING)
    walletBalance   Float              @default(0)
  earningsBalance Float              @default(0)
  discountPercent Float              @default(10)
  createdAt       DateTime           @default(now())
  storeMarkup     Float              @default(0)
  storeSlug       String?            @unique
    afaOrders       AfaOrder[]
  user            User               @relation(fields: [userId], references: [id])
  sales           AgentSale[]
  transactions    AgentTransaction[]
  apiKey          ApiKey?
}

model AgentTransaction {
  id                String                 @id @default(uuid())
  agentId           String
  type              AgentTransactionType
  amount            Float
  description       String?
  paystackReference String?                @unique
  status            AgentTransactionStatus @default(COMPLETED)
  createdAt         DateTime               @default(now())
  agent             AgentProfile            @relation(fields: [agentId], references: [id])
}

model AgentSale {
  id                String            @id @default(uuid())
  agentId           String
  bundleId          String
  beneficiaryNumber String
  resellerCost      Float
  customerPrice     Float
  profit            Float
  supplierOrderId   String?
  status            FulfillmentStatus @default(NOT_STARTED)
  failureReason     String?
  createdAt         DateTime          @default(now())
  agent             AgentProfile      @relation(fields: [agentId], references: [id])
  bundle            DataBundle        @relation(fields: [bundleId], references: [id])
}

model DigitalProduct {
  id                 String            @id @default(uuid())
  title              String
  description        String?
  category           String?
  price              Float
  deliveryType       String            @default("DOWNLOAD")
  fileUrl            String            @default("")
  revealContent      String?
  coverUrl           String?
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  deliveryEstimate   String?
  featured           Boolean           @default(false)
  instantDelivery    Boolean           @default(false)
    instructions       String?
  accessNote         String?
  platform           String?
  productType        String            @default("DIGITAL")
  quantity           String?
  requirements       String?
  stock              Int?
  smmQuantity        Int?
  smmServiceId       Int?
  gmailLabel         String?
  gmailAddress       String?
  gmailRevealSeconds Int               @default(60)
  deliveryMethods    String            @default("DIGITAL")
  optionsJson        String?
  requireWhatsapp    Boolean            @default(false)
  purchases          DigitalPurchase[]
}

model DigitalPurchase {
  id                      String         @id @default(uuid())
  productId               String
  userId                  String?
  guestEmail              String?
  amount                  Float
  paystackReference       String         @unique
  paymentStatus           PaymentStatus  @default(PENDING)
  createdAt               DateTime       @default(now())
  note                    String?
  smmOrderId              String?
  smmStatus               String?
  socialLink              String?
  revealStartedAt         DateTime?
  revealedGmailInstruction String?
  revealedGmailText       String?
  confirmedAt             DateTime?
  checkAttempts           Int            @default(0)
  chosenOption             String?
  deliveryMethod           String?
  whatsapp                 String?
  product                  DigitalProduct @relation(fields: [productId], references: [id])
}

model AiCreditPurchase {
  id                String        @id @default(uuid())
  userId            String
  credits            Int
  amount            Float
  paystackReference String        @unique
  paymentStatus     PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  type      String
  source    String?
  path      String?
  productId String?
  amount    Float?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([source])
}

model SmmSettings {
  id        String @id @default("default")
  markupPct Float  @default(30)
  usdToGhs  Float  @default(14)
}

model BoostOrder {
  id                String        @id @default(uuid())
  userId            String
  serviceId         Int
  serviceName       String
  link              String
  quantity          Int
  amount            Float
  paystackReference String        @unique
  paymentStatus     PaymentStatus @default(PENDING)
  panelOrderId      String?
  panelStatus       String?
  createdAt         DateTime      @default(now())
  user              User          @relation(fields: [userId], references: [id])
}

enum Role {
  CUSTOMER
  ADMIN
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum FulfillmentStatus {
  NOT_STARTED
  PROCESSING
  DELIVERED
  FAILED
}

enum PinStatus {
  AVAILABLE
  SOLD
}

enum AgentStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum AgentTransactionType {
  TOPUP
  SALE
  WITHDRAWAL
}

enum AgentTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}


// A customer's SMS-number rental (SMSPool). Same prepaid-balance +
// auto-refund-on-failure pattern as BoostOrder.
model SmsOrder {
  id                String    @id @default(uuid())
  userId            String
  countryId         String
  countryName       String
  serviceId         String
  serviceName       String
  amount            Float
  paystackReference String    @unique
  paymentStatus     String    @default("PENDING")
  poolOrderId       String?
  phoneNumber       String?
  smsCode           String?
  fullSms           String?
  status            String    @default("PENDING") // PENDING, WAITING, RECEIVED, EXPIRED, or FAILED: <reason>
  expiresAt         DateTime?
  refunded          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id])
}

// Ledger for the SMS Numbers wallet - every deposit, debit, and refund.
model SmsWalletTransaction {
  id                String   @id @default(uuid())
  userId            String
  type              String   // DEPOSIT, DEBIT, REFUND
  amount            Float
  status            String   @default("COMPLETED") // DEPOSIT starts PENDING until Paystack confirms
  paystackReference String?  @unique // only set for DEPOSIT
  relatedOrderId    String?  // the SmsOrder this DEBIT/REFUND belongs to, if any
  description       String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id])
}

// Independent margin settings for SMS Numbers, deliberately separate from
// SmmSettings so boosting margins and SMS margins can be tuned on their own
// - they're different businesses with different cost structures.
model SmsPoolSettings {
  id        String @id @default("default")
  markupPct Float  @default(40)
  usdToGhs  Float  @default(14)
}



// API key for reseller/agent API access. Tied to an agent; orders placed with
// this key bill that agent's top-up wallet and use their reseller pricing.
model ApiKey {
  id        String   @id @default(uuid())
  agentId   String   @unique
  agent     AgentProfile @relation(fields: [agentId], references: [id])
  key       String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
}

